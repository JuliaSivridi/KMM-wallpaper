{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kmm-wallpaper",
  "version": "1.1.0",
  "identifier": "com.stler.kmm-wallpaper",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "kmm-wallpaper",
        "width": 1920,
        "height": 1080,
		"alwaysOnBottom": true,
		"decorations": false,
		"transparent": true,
		"fullscreen": false,
		"resizable": false,
		"minimizable": false,
		"skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
"bundle": {
  "active": true,
  "targets": ["nsis"],
  "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
  "windows": {
    "nsis": {
      "installMode": "both"
    }
  }
}


}
